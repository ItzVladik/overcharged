$Macro SRCDIR		"..\.."
$Macro GAMENAME 	"hl2" [!$SOURCESDK]
$Macro GAMENAME 	"mod_hl2" [$SOURCESDK]

$Include "$SRCDIR\game\client\client_base.vpc"

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories	".\hl2;.\hl2\elements;$SRCDIR\game\shared\hl2;$SRCDIR\public\lua;$SRCDIR\public\sqlite3;.\overcharged;.\overcharged\OVR_VGUI;.\overcharged\OVR_VGUI\UNUSED;$BASE"
		$PreprocessorDefinitions		"$BASE;HL2_CLIENT_DLL;MAPBASE"
	}

	$Linker
	{
		$AdditionalDependencies			"$BASE;lua52.lib;sqlite3.lib"
	}
}

